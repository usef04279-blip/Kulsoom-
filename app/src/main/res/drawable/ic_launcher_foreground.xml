            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Core Orb -->
    <path
        android:pathData="M54,54m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="36"
                android:endX="72"
                android:endY="72"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="0.45" />
                <item android:color="#FF4081" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Pulse Highlight -->
    <path
        android:pathData="M54,54m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.75" />

    <!-- Waveform particle bars inside safe zone -->
    <path
        android:pathData="M44,52h2v4h-2z M53,49h2v10h-2z M62,52h2v4h-2z"
        android:fillColor="#FFFFFF" />
