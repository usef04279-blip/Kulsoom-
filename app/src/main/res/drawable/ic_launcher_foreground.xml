        android:strokeWidth="2.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="0.5" />
                <item android:color="#E040FB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Orbit Ring -->
    <path
        android:pathData="M54,54m-26,0a26,26 0,1 1,52 0a26,26 0,1 1,-52 0"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="80"
                android:startY="28"
                android:endX="28"
                android:endY="80"
                android:type="linear">
                <item android:color="#E040FB" android:offset="0.0" />
